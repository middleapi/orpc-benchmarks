{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Scripts run directly with Node.js type stripping.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "playground",
    "scripts",
    "tests",
    "*",

    "*/*/src/**/*.test.*",
    "*/*/src/**/*.test-d.ts",
    "*/*/src/**/*.bench.*",
    "*/*/src/**/__tests__",
    "*/*/src/**/__mocks__",
    "*/*/src/**/__snapshots__",
    "*/*/playground",
    "*/*/scripts",
    "*/*/tests",
    "*/*/*",

    // The servers under test (not the generated typecheck-* projects, which have their own config).
    "benchmarks/rpc-*/src",
    "benchmarks/ws-*/src",
    "benchmarks/openapi-*/src"
  ]
}

{
  "name": "@orpc-benchmarks/repo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "node scripts/bench.ts",
    "bench:report": "node scripts/bench.ts --report-only",
    "bench:profile": "node scripts/bench.ts --profile",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "repo:fix": "sherif --fix"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.6",
    "@orpc/client": "2.0.0-beta.50",
    "@orpc/openapi": "2.0.0-beta.50",
    "@orpc/server": "2.0.0-beta.50",
    "@trpc/client": "11.28.0",
    "@trpc/server": "11.28.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "clinic": "^13.0.0",
    "hono": "^4.13.17",
    "oxfmt": "^0.78.0",
    "sherif": "^1.13.0",
    "superjson": "^2.2.6",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "ws": "^8.22.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.18.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  }
}
